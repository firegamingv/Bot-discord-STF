# === Obligatoire ===
# Token du bot (https://discord.com/developers/applications)
DISCORD_TOKEN=

# === Recommandé ===
# ID du serveur Discord : les commandes slash y sont synchronisées instantanément.
# Laisser vide pour une synchronisation globale (peut prendre jusqu'à 1h).
GUILD_ID=

# Clé API Riot (https://developer.riotgames.com) — nécessaire pour lier un compte LoL
# et afficher les rangs. Sans clé, la liaison fonctionne en mode dégradé (sans vérification).
RIOT_API_KEY=
# Routage régional Riot : europe | americas | asia | sea
RIOT_REGION=europe
# Plateforme Riot (pour les rangs) : euw1 | eun1 | na1 | kr | ...
RIOT_PLATFORM=euw1

# === Optionnel ===
# Fuseau horaire utilisé pour saisir et afficher les dates
TIMEZONE=Europe/Paris
# Chemin de la base SQLite
DATABASE_PATH=data/bot.db
# Niveau de logs : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Dossier des fichiers de logs
LOG_DIR=logs
# Clé de l'API LoL Esports (clé publique utilisée par lolesports.com, modifiable si elle change)
LOLESPORTS_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z
